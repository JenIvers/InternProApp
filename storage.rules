rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Artifacts path: artifacts/{userId}/{artifactId}.{extension}
    match /artifacts/{userId}/{artifactId} {
      // Anyone can read artifacts (for sharing with advisors)
      allow read: if true;

      // Only the authenticated user can upload/modify/delete their own artifacts
      allow write, delete: if request.auth != null && request.auth.uid == userId;

      // Enforce file size limits (10MB)
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/pdf');
    }

    // Mentor portraits: mentors/{userId}/{mentorId}-{timestamp}.jpg
    match /mentors/{userId}/{photoId} {
      // Public read, like artifacts, so shared (?view=) portfolios can show photos
      allow read: if true;

      // Only the owner can replace or delete their mentors' photos
      allow update, delete: if request.auth != null && request.auth.uid == userId;

      // Images only, 5MB max
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
